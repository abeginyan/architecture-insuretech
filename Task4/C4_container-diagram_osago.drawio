<object placeholders="1" c4Name="osago-aggregator" c4Type="Container" c4Technology="Kotlin, SpringBoot" c4Description="Отправляет заявки в страховые, опрашивает предложения (до 60 с), публикует итог в Kafka. Несколько экземпляров" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#E6E6E6"&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;' id="n-osago-aggr"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#E8833A;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#B35F1F;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="1840" y="560" width="240" height="120" as="geometry"/></mxCell></object>
<object placeholders="1" c4Name="osago-aggregator-db" c4Type="Container" c4Technology="PostgreSQL" c4Description="Состояние «заявка × страховая»: статус, дедлайн 60 с, время опроса, попытки; таблица outbox" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%:&amp;nbsp;%c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#E6E6E6"&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;' id="n-osago-db"><mxCell style="shape=cylinder3;size=6;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#E8833A;fontSize=12;fontColor=#ffffff;align=center;strokeColor=#B35F1F;metaEdit=1;resizable=0;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.5,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="1840" y="860" width="240" height="120" as="geometry"/></mxCell></object>
