<mxfile host="app.diagrams.net"><diagram name="InsureTech_to-be" id="tobe1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="users" value="Пользователи из всех часовых поясов РФ&#xa;(браузеры, API партнёров)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FF6666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="20" width="400" height="60" as="geometry"/></mxCell><mxCell id="dns" value="Yandex Cloud DNS (GeoDNS), TTL 60 с&#xa;отдаёт IP ближайшего входа" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FF6666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="110" width="300" height="80" as="geometry"/></mxCell><mxCell id="cdn" value="Yandex Cloud CDN&#xa;статика фронтенда и кэш GET (каталог, тарифы)&#xa;edge-узлы в регионах РФ" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FF6666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="110" width="300" height="80" as="geometry"/></mxCell><mxCell id="alb" value="Application Load Balancer (L7), мультизональный, по узлу в каждой зоне&#xa;Health check: GET /healthz, интервал 5 с, таймаут 2 с, 3 ошибки = backend выведен, 2 успеха = возврат" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FF6666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="230" width="680" height="70" as="geometry"/></mxCell><mxCell id="e1" value="DNS-запрос" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=classic;fontSize=10;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="users" target="dns"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="статика" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=classic;fontSize=10;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="users" target="cdn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="IP балансировщика" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=classic;fontSize=10;exitX=0.5;exitY=1;entryX=0.15;entryY=0;dashed=1;" edge="1" parent="1" source="dns" target="alb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="cache miss / динамика" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=classic;fontSize=10;exitX=0.5;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="cdn" target="alb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="zoneA" value="Зона доступности A (ru-central1-a)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E1E9FF;strokeColor=none;arcSize=6;verticalAlign=bottom;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="500" height="620" as="geometry"/></mxCell><mxCell id="zoneB" value="Зона доступности B (ru-central1-b)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E1E9FF;strokeColor=none;arcSize=6;verticalAlign=bottom;fontSize=14;" vertex="1" parent="1"><mxGeometry x="570" y="360" width="500" height="620" as="geometry"/></mxCell><mxCell id="zoneD" value="Зона доступности D (ru-central1-d)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E1E9FF;strokeColor=none;arcSize=6;verticalAlign=bottom;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1100" y="360" width="500" height="620" as="geometry"/></mxCell><mxCell id="ngA" value="Группа узлов зоны A&#xa;HPA + Cluster Autoscaler, минимум 2 узла" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E1E9FF;strokeColor=#5282FF;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="460" height="225" as="geometry"/></mxCell><mxCell id="ingA" value="Ingress NGINX (2+ реплики), readiness/liveness probes" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FF6666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="480" width="420" height="30" as="geometry"/></mxCell><mxCell id="nsA" value="InsureTech namespace" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E1E9FF;strokeColor=#FF6666;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="520" width="420" height="135" as="geometry"/></mxCell><mxCell id="coreA" value="core-app (HPA, 2+ пода)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FF6666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="95" y="548" width="190" height="40" as="geometry"/></mxCell><mxCell id="cliA" value="client-info (HPA, 2+ пода)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FF6666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="295" y="548" width="190" height="40" as="geometry"/></mxCell><mxCell id="aggA" value="ins-product-aggregator (HPA)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FF6666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="95" y="598" width="190" height="40" as="geometry"/></mxCell><mxCell id="setA" value="ins-comp-settlement" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FF6666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="295" y="598" width="190" height="40" as="geometry"/></mxCell><mxCell id="vmA" value="ВМ БД, зона A: узел Patroni" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E1E9FF;strokeColor=#5282FF;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="460" height="235" as="geometry"/></mxCell><mxCell id="hapA" value="HAProxy + PgBouncer (запись :5432, чтение :5433)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FF6666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="735" width="420" height="40" as="geometry"/></mxCell><mxCell id="pgA" value="PostgreSQL + Patroni&#xa;PRIMARY" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FF6666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="800" width="420" height="60" as="geometry"/></mxCell><mxCell id="etcdA" value="etcd (DCS Patroni), кворум 2 из 3 зон" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FF6666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="880" width="420" height="40" as="geometry"/></mxCell><mxCell id="ngB" value="Группа узлов зоны B&#xa;HPA + Cluster Autoscaler, минимум 2 узла" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E1E9FF;strokeColor=#5282FF;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="440" width="460" height="225" as="geometry"/></mxCell><mxCell id="ingB" value="Ingress NGINX (2+ реплики), readiness/liveness probes" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FF6666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="480" width="420" height="30" as="geometry"/></mxCell><mxCell id="nsB" value="InsureTech namespace" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E1E9FF;strokeColor=#FF6666;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="520" width="420" height="135" as="geometry"/></mxCell><mxCell id="coreB" value="core-app (HPA, 2+ пода)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FF6666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="625" y="548" width="190" height="40" as="geometry"/></mxCell><mxCell id="cliB" value="client-info (HPA, 2+ пода)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FF6666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="825" y="548" width="190" height="40" as="geometry"/></mxCell><mxCell id="aggB" value="ins-product-aggregator (HPA)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FF6666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="625" y="598" width="190" height="40" as="geometry"/></mxCell><mxCell id="setB" value="ins-comp-settlement" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FF6666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="825" y="598" width="190" height="40" as="geometry"/></mxCell><mxCell id="vmB" value="ВМ БД, зона B: узел Patroni" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E1E9FF;strokeColor=#5282FF;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="700" width="460" height="235" as="geometry"/></mxCell><mxCell id="hapB" value="HAProxy + PgBouncer (запись :5432, чтение :5433)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FF6666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="735" width="420" height="40" as="geometry"/></mxCell><mxCell id="pgB" value="PostgreSQL + Patroni&#xa;SYNC REPLICA (кандидат на failover)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FF6666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="800" width="420" height="60" as="geometry"/></mxCell><mxCell id="etcdB" value="etcd (DCS Patroni), кворум 2 из 3 зон" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FF6666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="880" width="420" height="40" as="geometry"/></mxCell><mxCell id="ngD" value="Группа узлов зоны D&#xa;HPA + Cluster Autoscaler, минимум 2 узла" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E1E9FF;strokeColor=#5282FF;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="440" width="460" height="225" as="geometry"/></mxCell><mxCell id="ingD" value="Ingress NGINX (2+ реплики), readiness/liveness probes" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FF6666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="480" width="420" height="30" as="geometry"/></mxCell><mxCell id="nsD" value="InsureTech namespace" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E1E9FF;strokeColor=#FF6666;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="520" width="420" height="135" as="geometry"/></mxCell><mxCell id="coreD" value="core-app (HPA, 2+ пода)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FF6666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1155" y="548" width="190" height="40" as="geometry"/></mxCell><mxCell id="cliD" value="client-info (HPA, 2+ пода)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FF6666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1355" y="548" width="190" height="40" as="geometry"/></mxCell><mxCell id="aggD" value="ins-product-aggregator (HPA)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FF6666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1155" y="598" width="190" height="40" as="geometry"/></mxCell><mxCell id="setD" value="ins-comp-settlement" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FF6666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1355" y="598" width="190" height="40" as="geometry"/></mxCell><mxCell id="vmD" value="ВМ БД, зона D: узел Patroni" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E1E9FF;strokeColor=#5282FF;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="700" width="460" height="235" as="geometry"/></mxCell><mxCell id="hapD" value="HAProxy + PgBouncer (запись :5432, чтение :5433)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FF6666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="735" width="420" height="40" as="geometry"/></mxCell><mxCell id="pgD" value="PostgreSQL + Patroni&#xa;ASYNC REPLICA (чтение, DR)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FF6666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="800" width="420" height="60" as="geometry"/></mxCell><mxCell id="etcdD" value="etcd (DCS Patroni), кворум 2 из 3 зон" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FF6666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="880" width="420" height="40" as="geometry"/></mxCell><mxCell id="cluster" value="Региональный кластер Managed Kubernetes" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#5282FF;dashed=1;dashPattern=8 4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="395" width="1600" height="280" as="geometry"/></mxCell><mxCell id="albA" value="HTTP + health check /healthz" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=classic;fontSize=10;exitX=0.1;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="alb" target="ingA"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dbA" value="TCP 5432" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=classic;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="nsA" target="hapA"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="hcA" value="health check Patroni REST :8008" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=classic;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="hapA" target="pgA"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="albB" value="HTTP + health check /healthz" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=classic;fontSize=10;exitX=0.5;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="alb" target="ingB"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dbB" value="TCP 5432" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=classic;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="nsB" target="hapB"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="hcB" value="health check Patroni REST :8008" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=classic;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="hapB" target="pgB"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="albD" value="HTTP + health check /healthz" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=classic;fontSize=10;exitX=0.9;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="alb" target="ingD"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dbD" value="TCP 5432" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=classic;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="nsD" target="hapD"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="hcD" value="health check Patroni REST :8008" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=classic;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="hapD" target="pgD"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="syncAB" value="sync" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=classic;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=2;" edge="1" parent="1" source="pgA" target="pgB"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="asyncBD" value="async" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=classic;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="pgB" target="pgD"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bk1" value="Object Storage (регион основной): pgBackRest&#xa;полный бэкап раз в сутки, инкрементальный каждые 6 ч,&#xa;WAL-архив каждые 5 мин и чаще, хранение 14 дней" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FF6666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="1050" width="460" height="80" as="geometry"/></mxCell><mxCell id="bk2" value="Object Storage (второй регион)&#xa;копия бэкапов и WAL (защита от потери региона)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FF6666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="1050" width="460" height="80" as="geometry"/></mxCell><mxCell id="bkedge" value="бэкап и WAL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=classic;fontSize=10;exitX=0.15;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="vmA" target="bk1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bkrep" value="репликация бакета" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=classic;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bk1" target="bk2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="note0" value="МАСШТАБИРОВАНИЕ&#xa;&#xa;Выбор: горизонтальное масштабирование.&#xa;Вертикальное упирается в потолок размера ВМ, требует рестарта и остаётся единой точкой отказа.&#xa;Горизонтальное: HPA по CPU/RPS + Cluster Autoscaler, минимум 2 пода на сервис в каждой зоне, сервисы stateless и растут линейно.&#xa;Три зоны доступности: при потере одной оставшиеся две должны держать 100% пика, поэтому ёмкость каждой зоны не меньше 50% пиковой нагрузки (рекламная кампания)." style="shape=note;whiteSpace=wrap;html=0;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1170" width="310" height="330" as="geometry"/></mxCell><mxCell id="note1" value="KUBERNETES: ОДИН РАСТЯНУТЫЙ КЛАСТЕР&#xa;&#xa;Выбран один региональный кластер на 3 зоны (master в 3 зонах, группы узлов в каждой зоне), а не независимые кластеры.&#xa;Почему: зоны одного региона связаны каналом с задержкой в единицы мс; один набор манифестов и один деплой; нет рассинхрона версий между кластерами.&#xa;Распределение подов: topologySpreadConstraints по зонам + PodDisruptionBudget.&#xa;Минус: общий control plane. Смягчается региональным master. Независимые кластеры понадобятся при выходе в несколько регионов." style="shape=note;whiteSpace=wrap;html=0;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="380" y="1170" width="310" height="330" as="geometry"/></mxCell><mxCell id="note2" value="БАЛАНСИРОВКА И HEALTH CHECK&#xa;&#xa;1) GeoDNS, TTL 60 с.&#xa;2) CDN: статика и кэш GET на edge в регионах, динамика идёт в origin.&#xa;3) Мультизональный ALB (L7).&#xa;4) Ingress NGINX, Service, под.&#xa;5) HAProxy, Patroni primary/replica.&#xa;Health check: ALB, GET /healthz каждые 5 с, 3 ошибки = выведен (около 15 с); K8s readiness/liveness probes; HAProxy, Patroni REST :8008 (/primary, /replica).&#xa;Динамические запросы всё равно идут в один регион, поэтому разница по времени отклика остаётся из-за сетевой задержки; её снижают CDN, keep-alive и TLS-терминация на входе." style="shape=note;whiteSpace=wrap;html=0;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="720" y="1170" width="310" height="330" as="geometry"/></mxCell><mxCell id="note3" value="FAILOVER ДЛЯ КЛИЕНТА (ACTIVE-ACTIVE)&#xa;&#xa;Падение пода: readiness-probe убирает его из Service за секунды.&#xa;Падение узла: поды перезапускаются на других узлах.&#xa;Падение зоны: ALB за ~15 с перестаёт слать в неё трафик; Patroni переводит primary на sync-реплику другой зоны за 30-60 с.&#xa;Клиент: повтор запроса с backoff (идемпотентные GET), 5xx только на время переключения.&#xa;Оценка простоя 1-2 мин (требует проверки учениями), заметно меньше RTO 45 мин. Допустимый простой при 99,9%: около 43 мин в месяц." style="shape=note;whiteSpace=wrap;html=0;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1060" y="1170" width="310" height="330" as="geometry"/></mxCell><mxCell id="note4" value="БАЗА ДАННЫХ И ШАРДИРОВАНИЕ&#xa;&#xa;Patroni + etcd (3 узла, по одному в зоне). PostgreSQL: 1 primary + 1 sync + 1 async реплика, synchronous_mode без strict.&#xa;RPO: sync-реплика даёт почти 0 при потере зоны (если sync-реплика недоступна, Patroni временно переходит в async); WAL-архив каждые 5 мин (archive_timeout=300) = RPO не больше 5 мин, при требовании 15 мин.&#xa;RTO: автоматический failover 30-60 с; восстановление 50 GB из бэкапа оценочно 15-30 мин, при требовании 45 мин.&#xa;Шардирование НЕ применяем: 50 GB умещаются на одном узле, чтение разгружаем репликами, шардирование усложнит транзакции. Вернёмся к вопросу при росте за 1 TB или упоре в запись." style="shape=note;whiteSpace=wrap;html=0;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1400" y="1170" width="310" height="330" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>